{%- assign product = section.settings.product -%}
<section class="section{% if section.settings.alt_background %} section--alt{% endif %}" id="{{ section.settings.anchor | default: section.id }}" data-product>
  <div class="page-width">
    {%- if product != blank -%}
      {%- assign current = product.selected_or_first_available_variant -%}
      {%- liquid
        assign save_percent = 0
        if current.compare_at_price > current.price
          assign save_percent = current.compare_at_price | minus: current.price | times: 100 | divided_by: current.compare_at_price | floor
        endif
      -%}
      <div class="product">
        <div class="product__media">
          {% render 'product-gallery', product: product, uid: section.id %}
        </div>
        <div class="product__info">
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
          <h2 class="product__title"><a href="{{ product.url }}" style="text-decoration: none">{{ product.title }}</a></h2>
          <div class="product__price">
            <span data-price>{{ current.price | money }}</span>
            <s data-compare-price {% unless save_percent > 0 %}hidden{% endunless %}>{% if save_percent > 0 %}{{ current.compare_at_price | money }}{% endif %}</s>
            <span class="badge" data-save-badge {% unless save_percent > 0 %}hidden{% endunless %}>{% if save_percent > 0 %}Save {{ save_percent }}%{% endif %}</span>
          </div>
          {%- if section.settings.text != blank -%}<div class="product__subtitle rte">{{ section.settings.text }}</div>{%- endif -%}
          {%- if section.settings.highlights != blank -%}
            <ul class="product__highlights">
              {%- assign lines = section.settings.highlights | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}
                {%- assign l = line | strip -%}
                {%- if l != blank -%}<li>{% render 'icon', name: 'check' %}<span>{{ l }}</span></li>{%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {% render 'buy-box', product: product, section: section, main: false, show_payment_button: section.settings.show_payment_button, show_quantity: false, show_perks: false %}
          <p style="margin: 20px 0 0"><a href="{{ product.url }}" class="link">View full details{% render 'icon', name: 'arrow' %}</a></p>
        </div>
      </div>
    {%- else -%}
      <div class="product">
        <div class="media media--drawing media--square">{% render 'drawing', name: 'front', uid: section.id %}</div>
        <div class="product__info">
          <h2 class="product__title">Featured product</h2>
          <p class="text-muted">Choose a product for this section in the theme editor.</p>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured product",
  "class": "section-featured-product",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "info": "Lets menu links jump here, e.g. /#shop", "default": "shop" },
    { "type": "text", "id": "eyebrow", "label": "Small heading" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Hard cap knee pads with a gel cushion and silicone-lined straps that grip your pants instead of squeezing your leg.</p>" },
    { "type": "textarea", "id": "highlights", "label": "Highlights", "info": "One per line.", "default": "Silicone grip lining holds onto your pant legs\nTwo adjustable straps, one above and one below the knee\nGel cushion over high-density foam\nHard shell cap for concrete, tile and subfloor" },
    { "type": "checkbox", "id": "show_payment_button", "label": "Show dynamic checkout button", "default": false },
    { "type": "checkbox", "id": "alt_background", "label": "Alternate background", "default": false }
  ],
  "presets": [{ "name": "Featured product" }]
}
{% endschema %}
