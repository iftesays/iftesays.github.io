<section class="section{% if section.settings.alt_background %} section--alt{% endif %}" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor }}"{% endif %}>
  <div class="page-width image-text{% if section.settings.layout == 'media_right' %} image-text--reverse{% endif %}">
    <div class="image-text__media reveal">
      <div class="compare-slider" data-compare-slider style="--pos: 50%">
        <div class="compare-slider__layer compare-slider__layer--before">
          {%- if section.settings.before_image != blank -%}
            {{ section.settings.before_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 750px) 50vw, 100vw', alt: section.settings.before_label }}
          {%- else -%}
            {% render 'drawing', name: 'leg-slipped', uid: section.id %}
          {%- endif -%}
          <span class="compare-slider__label compare-slider__label--left">{{ section.settings.before_label }}</span>
        </div>
        <div class="compare-slider__layer compare-slider__layer--after" aria-hidden="true">
          {%- if section.settings.after_image != blank -%}
            {{ section.settings.after_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 750px) 50vw, 100vw', alt: '' }}
          {%- else -%}
            {% render 'drawing', name: 'leg-holdfast', uid: section.id %}
          {%- endif -%}
          <span class="compare-slider__label compare-slider__label--right">{{ section.settings.after_label }}</span>
        </div>
        <div class="compare-slider__handle" aria-hidden="true"><span>{% render 'icon', name: 'chevron' %}{% render 'icon', name: 'chevron' %}</span></div>
        <input class="compare-slider__input" type="range" min="0" max="100" value="50" step="1" aria-label="Drag to compare {{ section.settings.before_label | escape }} with {{ section.settings.after_label | escape }}">
      </div>
      {%- if section.settings.caption != blank -%}<p class="compare-slider__caption">{{ section.settings.caption }}</p>{%- endif -%}
    </div>
    <div class="image-text__content reveal" style="--delay: 80ms">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="image-text__list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %}<span>{{ block.settings.text }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Before / after slider",
  "class": "section-compare-slider",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID" },
    { "type": "image_picker", "id": "before_image", "label": "Left image", "info": "Without images, drawings are shown." },
    { "type": "text", "id": "before_label", "label": "Left label", "default": "Basic strap pad" },
    { "type": "image_picker", "id": "after_image", "label": "Right image" },
    { "type": "text", "id": "after_label", "label": "Right label", "default": "Holdfast" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Illustration. Drag to compare." },
    { "type": "select", "id": "layout", "label": "Layout", "default": "media_left", "options": [
      { "value": "media_left", "label": "Slider left" },
      { "value": "media_right", "label": "Slider right" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why they don't slide down" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A basic strap knee pad stays up one way: a tight band behind the knee. Holdfast uses two straps, one above the knee and one below, lined with silicone that grips your pants.</p>" },
    { "type": "checkbox", "id": "alt_background", "label": "Alternate background", "default": false }
  ],
  "blocks": [
    { "type": "point", "name": "List item", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Silicone lining grips your pant leg" } ] }
  ],
  "presets": [{ "name": "Before / after slider" }]
}
{% endschema %}
