{%- assign current = product.selected_or_first_available_variant -%}
{%- liquid
  assign save_percent = 0
  if current.compare_at_price > current.price
    assign save_percent = current.compare_at_price | minus: current.price | times: 100 | divided_by: current.compare_at_price | floor
  endif
-%}
<section class="section section--tight-top" data-product style="padding-top: 32px">
  <div class="page-width product">
    <div class="product__media">
      {% render 'product-gallery', product: product, uid: section.id, lcp: true %}
    </div>

    <div class="product__info">
      <nav class="product__breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a> / <span aria-current="page">{{ product.title }}</span>
      </nav>
      <h1 class="product__title">{{ product.title }}</h1>
      <div class="product__price">
        <span data-price>{{ current.price | money }}</span>
        <s data-compare-price {% unless save_percent > 0 %}hidden{% endunless %}>{% if save_percent > 0 %}{{ current.compare_at_price | money }}{% endif %}</s>
        <span class="badge" data-save-badge {% unless save_percent > 0 %}hidden{% endunless %}>{% if save_percent > 0 %}Save {{ save_percent }}%{% endif %}</span>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'text' -%}
            <div class="product__subtitle rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'highlights' -%}
            <ul class="product__highlights" {{ block.shopify_attributes }}>
              {%- assign lines = block.settings.lines | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}
                {%- assign l = line | strip -%}
                {%- if l != blank -%}<li>{% render 'icon', name: 'check' %}<span>{{ l }}</span></li>{%- endif -%}
              {%- endfor -%}
            </ul>

          {%- when 'buy_buttons' -%}
            <div {{ block.shopify_attributes }}>
              {% render 'buy-box', product: product, section: section, main: true, show_payment_button: block.settings.show_payment_button, show_quantity: block.settings.show_quantity, show_perks: true %}
            </div>

          {%- when 'collapsible' -%}
            {%- assign prev_index = forloop.index0 | minus: 1 -%}
            {%- if forloop.first or section.blocks[prev_index].type != 'collapsible' -%}<div class="product__accordions">{%- endif -%}
            <details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }}{% render 'icon', name: 'plus' %}</summary>
              <div class="accordion__content rte">
                {%- if block.settings.source == 'description' -%}
                  {{ product.description }}
                {%- else -%}
                  {{ block.settings.content }}
                {%- endif -%}
              </div>
            </details>
            {%- assign next_index = forloop.index0 | plus: 1 -%}
            {%- if forloop.last or section.blocks[next_index].type != 'collapsible' -%}</div>{%- endif -%}

          {%- when '@app' -%}
            <div {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<div class="sticky-atc" data-sticky-atc aria-hidden="true">
  <div class="page-width sticky-atc__inner">
    <div class="sticky-atc__media">
      {%- if product.featured_media -%}
        <div class="media media--product">{{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}</div>
      {%- else -%}
        <div class="media media--drawing">{% render 'drawing', name: 'front', uid: 'sticky' %}</div>
      {%- endif -%}
    </div>
    <div class="sticky-atc__info">
      <strong>{{ product.title }}</strong>
      <span>{% unless product.has_only_default_variant %}<span data-sticky-variant>{{ current.title }}</span> · {% endunless %}<span data-sticky-price>{{ current.price | money }}</span></span>
    </div>
    <button type="button" class="btn" data-sticky-add tabindex="-1" {% unless current.available %}disabled{% endunless %}>{% if current.available %}Add to cart{% else %}Sold out{% endif %}</button>
  </div>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ request.origin | append: product.url | json }},
  "description": {{ product.description | strip_html | json }},
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  {%- if product.featured_media -%}
  "image": [{{ product.featured_media | image_url: width: 1600 | prepend: 'https:' | json }}],
  {%- endif -%}
  "offers": [
    {%- for variant in product.variants -%}
    {
      "@type": "Offer",
      {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
      "name": {{ variant.title | json }},
      "price": {{ variant.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "url": {{ request.origin | append: variant.url | json }}
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
  "name": "Product information",
  "class": "section-main-product",
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Hard cap knee pads with a gel cushion and silicone-lined straps that grip your pants instead of squeezing your leg.</p>" }
      ]
    },
    {
      "type": "highlights",
      "name": "Highlights",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "lines", "label": "Lines", "info": "One per line.", "default": "Silicone grip lining holds onto your pant legs\nTwo adjustable straps, one above and one below the knee\nGel cushion over high-density foam\nHard shell cap for concrete, tile and subfloor" }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_payment_button", "label": "Show dynamic checkout button", "default": true },
        { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": true }
      ]
    },
    {
      "type": "collapsible",
      "name": "Collapsible tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Description" },
        { "type": "select", "id": "source", "label": "Content", "default": "custom", "options": [
          { "value": "description", "label": "Product description" },
          { "value": "custom", "label": "Custom text" }
        ] },
        { "type": "richtext", "id": "content", "label": "Custom text" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    },
    { "type": "@app" }
  ]
}
{% endschema %}
