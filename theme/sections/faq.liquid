<section class="section{% if section.settings.alt_background %} section--alt{% endif %}" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor }}"{% endif %}>
  <div class="page-width">
    <div class="faq">
      <div class="faq__intro reveal">
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="rte text-muted">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <p style="margin-top: 20px"><a href="{{ section.settings.link }}" class="link">{{ section.settings.link_label }}{% render 'icon', name: 'arrow' %}</a></p>
        {%- endif -%}
      </div>
      <div class="reveal" style="--delay: 80ms">
        {%- for block in section.blocks -%}
          <details class="accordion" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}{% render 'icon', name: 'plus' %}</summary>
            <div class="accordion__content rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "faq" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Can't find what you're looking for? Send us a message.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Contact us" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "alt_background", "label": "Alternate background", "default": false }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Will they stay up when I stand?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>That's what they're designed to do. The silicone lining inside each strap grips your pants, and the two straps hold the pad over your kneecap instead of relying on one tight band.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
