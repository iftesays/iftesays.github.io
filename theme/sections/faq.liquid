<section class="section{% if section.settings.dark %} section--ink{% endif %}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="wrap faq-sec">
    <div class="section-head reveal">
      <p class="label-mono label-mono--accent">{{ section.settings.kicker }}</p>
      <h2 class="h1">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="section-head__text rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="faq">
      {%- for block in section.blocks -%}
        <details class="faq__item reveal" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.question }}</span><i aria-hidden="true">{% render 'icon', name: 'plus' %}</i></summary>
          <div class="faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "faq" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions before you kneel" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": true },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Will they really stay up?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>That's what they're designed for. The silicone lining grips your pants and the two straps hold the pad over the joint, not behind it. If they slide on you anyway, the guarantee covers it.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
