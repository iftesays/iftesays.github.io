<section class="section">
  <div class="page-width page-width--medium">
    <a href="{{ routes.account_url }}" class="text-muted">← Account</a>
    <h1 class="h2">Order {{ order.name }}</h1>
    <p>Placed {{ order.created_at | date: '%B %d, %Y' }}{% if order.cancelled %} · Cancelled: {{ order.cancel_reason_label }}{% endif %}</p>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Product</th><th>Price</th><th>Qty</th><th>Total</th></tr></thead>
        <tbody>
          {%- for line_item in order.line_items -%}
            <tr>
              <td>{{ line_item.title | link_to: line_item.product.url }}
                {%- if line_item.fulfillment -%}<br><small>Shipped {{ line_item.fulfillment.created_at | date: '%b %d' }}{% if line_item.fulfillment.tracking_url %} · <a href="{{ line_item.fulfillment.tracking_url }}">Track</a>{% endif %}</small>{%- endif -%}
              </td>
              <td>{{ line_item.final_price | money }}</td>
              <td>{{ line_item.quantity }}</td>
              <td>{{ line_item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr><td colspan="3">Subtotal</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
          {%- for shipping_method in order.shipping_methods -%}<tr><td colspan="3">Shipping ({{ shipping_method.title }})</td><td>{{ shipping_method.price | money }}</td></tr>{%- endfor -%}
          {%- for tax_line in order.tax_lines -%}<tr><td colspan="3">Tax ({{ tax_line.title }})</td><td>{{ tax_line.price | money }}</td></tr>{%- endfor -%}
          <tr><td colspan="3"><strong>Total</strong></td><td><strong>{{ order.total_price | money_with_currency }}</strong></td></tr>
        </tfoot>
      </table>
    </div>
    <div class="field-row">
      <div><h2 class="h3">Shipping address</h2>{{ order.shipping_address | format_address }}</div>
      <div><h2 class="h3">Billing address</h2>{{ order.billing_address | format_address }}</div>
    </div>
  </div>
</section>
{% schema %}
{ "name": "Order", "settings": [] }
{% endschema %}
