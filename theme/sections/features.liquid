<section class="section{% if section.settings.dark %} section--ink{% endif %}" id="{{ section.settings.anchor | default: section.id }}">
  <div class="wrap">
    <div class="section-head{% if section.settings.center %} section-head--center{% endif %} reveal">
      <p class="label-mono label-mono--accent">{{ section.settings.kicker }}</p>
      <h2 class="h1">{{ section.settings.heading }}</h2>
    </div>
    <div class="features">
      {%- for block in section.blocks -%}
        <article class="feature reveal" style="--d: {{ forloop.index0 | times: 100 }}ms" {{ block.shopify_attributes }}>
          <div class="feature__top">
            <span class="feature__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="feature__icon">{% render 'icon', name: block.settings.icon %}</span>
          </div>
          <h3 class="h3">{{ block.settings.title }}</h3>
          <div class="rte">{{ block.settings.text }}</div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Features",
  "class": "section-features",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Why Holdfast" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built around one job: staying put" },
    { "type": "checkbox", "id": "center", "label": "Center heading", "default": false },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "grip", "options": [
          { "value": "grip", "label": "Grip" },
          { "value": "strap", "label": "Straps" },
          { "value": "drop", "label": "Gel" },
          { "value": "cap", "label": "Cap" },
          { "value": "shield", "label": "Shield" },
          { "value": "truck", "label": "Truck" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "They stay up" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A silicone grip band holds onto your work pants. Kneel, stand, climb the ladder, kneel again. Still there.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Features", "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }] }]
}
{% endschema %}
