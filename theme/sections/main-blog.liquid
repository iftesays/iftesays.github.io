<div class="page-width">
  <header class="page-header"><h1>{{ blog.title }}</h1></header>
  {%- paginate blog.articles by 9 -%}
    <div class="grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="card reveal">
          {%- if article.image -%}
            {%- assign alt = article.image.alt | default: article.title -%}
            <div class="media media--landscape media--zoom">{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 33vw, 100vw', alt: alt }}</div>
          {%- endif -%}
          <h2 class="card__title">{{ article.title }}</h2>
          <p class="card__price">{{ article.published_at | date: '%B %-d, %Y' }}</p>
        </a>
      {%- else -%}
        <p class="empty-state">No posts yet.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</div>
<div style="height: var(--section-space)"></div>

{% schema %}
{ "name": "Blog", "class": "section-main-blog", "settings": [] }
{% endschema %}
