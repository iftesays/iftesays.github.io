{%- comment -%}
  Add real customer reviews as blocks (or replace this section with a
  reviews app such as Judge.me). With no blocks it shows an honest
  "reviews coming" note instead of placeholder testimonials.
{%- endcomment -%}
<section class="section" id="{{ section.settings.anchor | default: section.id }}">
  <div class="wrap">
    <div class="section-head section-head--center reveal">
      <p class="label-mono label-mono--accent">{{ section.settings.kicker }}</p>
      <h2 class="h1">{{ section.settings.heading }}</h2>
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="reviews">
        {%- for block in section.blocks -%}
          <figure class="review reveal" style="--d: {{ forloop.index0 | times: 90 }}ms" {{ block.shopify_attributes }}>
            <div class="review__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..5) -%}<span class="{% if i <= block.settings.rating %}is-on{% endif %}">★</span>{%- endfor -%}
            </div>
            <blockquote>{{ block.settings.text }}</blockquote>
            <figcaption><strong>{{ block.settings.name }}</strong>{% if block.settings.trade != blank %} · {{ block.settings.trade }}{% endif %}{% if block.settings.verified %} <span class="verified">{% render 'icon', name: 'check' %} Verified buyer</span>{% endif %}</figcaption>
          </figure>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="reviews-empty reveal">
        <p class="h3">{{ section.settings.empty_heading }}</p>
        <p>{{ section.settings.empty_text }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "class": "section-reviews",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "reviews" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the job site" },
    { "type": "text", "id": "empty_heading", "label": "Heading when there are no reviews", "default": "We're new, and we don't post reviews we didn't earn." },
    { "type": "text", "id": "empty_text", "label": "Text when there are no reviews", "default": "Verified buyer reviews will show up here as the first orders get worn in." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "trade", "label": "Trade" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true }
      ]
    }
  ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
