<section class="section section--ink" id="{{ section.settings.anchor | default: section.id }}">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="label-mono label-mono--accent">{{ section.settings.kicker }}</p>
      <h2 class="h1">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="section-head__text rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="quotes">
      {%- for block in section.blocks -%}
        <figure class="quote reveal" style="--d: {{ forloop.index0 | times: 90 }}ms" {{ block.shopify_attributes }}>
          <blockquote>{{ block.settings.quote }}</blockquote>
          <figcaption class="label-mono">{{ block.settings.caption }}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pain quotes",
  "class": "section-pain",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "why" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The problem" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You've already paid to fix this. It didn't work." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The same complaint shows up across the flooring, carpentry, electrical, HVAC and construction forums. It isn't one bad brand. Most strap knee pads fail the same way.</p>" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "They slide down literally every time I stand up." },
        { "type": "text", "id": "caption", "label": "Caption", "default": "The most common complaint" }
      ]
    }
  ],
  "presets": [{ "name": "Pain quotes", "blocks": [{ "type": "quote" }, { "type": "quote" }, { "type": "quote" }] }]
}
{% endschema %}
