<article class="section page-sec">
  <div class="wrap wrap--narrow">
    <a href="{{ blog.url }}" class="label-mono label-mono--accent">← {{ blog.title }}</a>
    <h1 class="h1">{{ article.title }}</h1>
    <p class="label-mono">{{ article.published_at | date: '%B %d, %Y' }}{% if article.author %} · {{ article.author }}{% endif %}</p>
    {%- if article.image -%}<div class="article-img">{{ article.image | image_url: width: 1600 | image_tag: widths: '800, 1200, 1600', alt: article.title }}</div>{%- endif -%}
    <div class="rte rte--lg">{{ article.content }}</div>
  </div>
</article>

{% schema %}
{ "name": "Article", "class": "section-main-article", "settings": [] }
{% endschema %}
