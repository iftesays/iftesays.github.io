<section class="section">
  <div class="page-width page-width--medium">
    <a href="{{ routes.account_url }}" class="text-muted">← Account</a>
    <h1 class="h2">Addresses</h1>
    {%- paginate customer.addresses by 10 -%}
      <div class="grid">
        {%- for address in customer.addresses -%}
          <div class="form-card">
            {%- if address == customer.default_address -%}<span class="text-muted">Default</span>{%- endif -%}
            {{ address | format_address }}
            {%- form 'customer_address', address -%}
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="link-plain" onclick="return confirm('Delete this address?')">Delete</button>
            {%- endform -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endpaginate -%}
    <div class="form-card">
      <h2 class="h3">Add a new address</h2>
      {%- form 'customer_address', customer.new_address -%}
        {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field-row">
          <label class="field"><span>First name</span><input type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></label>
          <label class="field"><span>Last name</span><input type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></label>
        </div>
        <label class="field"><span>Company</span><input type="text" name="address[company]" value="{{ form.company }}"></label>
        <label class="field"><span>Address</span><input type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></label>
        <label class="field"><span>Apartment, suite, etc.</span><input type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></label>
        <div class="field-row">
          <label class="field"><span>City</span><input type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></label>
          <label class="field"><span>ZIP</span><input type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></label>
        </div>
        <div class="field-row">
          <label class="field"><span>Country</span><select name="address[country]" data-default="{{ form.country }}">{{ all_country_option_tags }}</select></label>
          <label class="field"><span>State / province</span><input type="text" name="address[province]" value="{{ form.province }}"></label>
        </div>
        <label class="field"><span>Phone</span><input type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></label>
        <label class="checkbox">{{ form.set_as_default_checkbox }} Set as default address</label>
        <button type="submit" class="btn">Add address</button>
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Addresses", "settings": [] }
{% endschema %}
