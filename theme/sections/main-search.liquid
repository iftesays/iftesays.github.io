<div class="page-width">
  <header class="page-header">
    <h1>{% if search.performed %}Search results{% else %}Search{% endif %}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <label class="visually-hidden" for="SearchInput">Search</label>
      <input class="input" id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search" autocomplete="off">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="btn">Search</button>
    </form>
  </header>
  {%- if search.performed -%}
    {%- paginate search.results by 12 -%}
      {%- if search.results_count == 0 -%}
        <p class="empty-state">No results for “{{ search.terms | escape }}”. Try “knee pads”.</p>
      {%- else -%}
        <p class="text-muted">{{ search.results_count }} {{ search.results_count | pluralize: 'result', 'results' }} for “{{ search.terms | escape }}”</p>
        <div class="grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <a href="{{ item.url }}" class="card reveal">
                <h2 class="card__title">{{ item.title }}</h2>
                <p class="card__price">{{ item.content | strip_html | truncatewords: 24 }}</p>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>
<div style="height: var(--section-space)"></div>

{% schema %}
{ "name": "Search", "class": "section-main-search", "settings": [] }
{% endschema %}
