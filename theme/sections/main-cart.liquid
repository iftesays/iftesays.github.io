<div class="page-width">
  <header class="page-header"><h1>Your cart</h1></header>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-page" id="CartForm">
      <ul class="cart-items">
        {%- for item in cart.items -%}
          <li class="cart-item">
            <a href="{{ item.url }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}
                <div class="media media--product">{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}</div>
              {%- else -%}
                <div class="media media--drawing">{% render 'drawing', name: 'front', uid: item.key %}</div>
              {%- endif -%}
            </a>
            <div>
              <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}<span class="cart-item__variant">{{ item.variant.title }}</span>{%- endunless -%}
              <div class="cart-item__actions">
                <label class="visually-hidden" for="Updates-{{ forloop.index }}">Quantity</label>
                <input class="input" style="width: 80px; min-height: 40px; padding: 6px 10px" id="Updates-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
                <a href="{{ item.url_to_remove }}" class="link-plain">Remove</a>
              </div>
            </div>
            <div class="cart-item__price">
              {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
              {{ item.final_line_price | money }}
            </div>
          </li>
        {%- endfor -%}
      </ul>
      <div class="cart-page__summary">
        <div class="cart-totals"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
        <p class="cart-drawer__note">Free US shipping. Taxes calculated at checkout.</p>
        <div class="field">
          <label for="CartNote">Order notes (optional)</label>
          <textarea id="CartNote" name="note">{{ cart.note }}</textarea>
        </div>
        <button type="submit" name="checkout" class="btn">Check out</button>
        <button type="submit" name="update" class="link-plain" style="margin-top: 12px">Update cart</button>
        {%- if additional_checkout_buttons -%}<div style="margin-top: 16px">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
      </div>
    </form>
  {%- else -%}
    <div class="empty-state">
      <p>Your cart is empty.</p>
      <a href="{{ settings.primary_product.url | default: routes.all_products_collection_url }}" class="btn">Shop knee pads</a>
    </div>
  {%- endif -%}
</div>
<div style="height: var(--section-space)"></div>

{% schema %}
{ "name": "Cart", "class": "section-main-cart", "settings": [] }
{% endschema %}
