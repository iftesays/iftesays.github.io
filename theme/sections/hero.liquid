{%- assign image = section.settings.image -%}
{%- capture content -%}
  {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
  <h1>{{ section.settings.heading }}</h1>
  {%- if section.settings.text != blank -%}<div class="hero__text">{{ section.settings.text }}</div>{%- endif -%}
  <div class="hero__buttons">
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn{% if image != blank %} btn--light{% endif %}">{{ section.settings.button_label }}</a>
    {%- endif -%}
    {%- if section.settings.button_2_label != blank -%}
      <a href="{{ section.settings.button_2_link }}" class="btn {% if image != blank %}btn--outline-light{% else %}btn--secondary{% endif %}">{{ section.settings.button_2_label }}</a>
    {%- endif -%}
  </div>
  {%- if section.settings.note != blank -%}
    <ul class="hero__note">
      {%- assign notes = section.settings.note | split: '·' -%}
      {%- for n in notes -%}<li>{% render 'icon', name: 'check' %}{{ n | strip }}</li>{%- endfor -%}
    </ul>
  {%- endif -%}
{%- endcapture -%}

{%- if image != blank -%}
  <section class="hero">
    <div class="hero__media">
      {%- assign alt = image.alt | default: '' -%}
      {{ image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1800, 2400', sizes: '100vw', alt: alt }}
    </div>
    <div class="page-width hero__content">
      <div>{{ content }}</div>
    </div>
  </section>
{%- else -%}
  <section class="hero hero--split">
    <div class="page-width hero__grid">
      <div class="hero__content">{{ content }}</div>
      <div class="hero__drawing">{% render 'drawing', name: 'pair', uid: section.id %}</div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "A wide photo of the pads in use, at least 2400px wide. Text sits on the left, so keep the subject to the right. Without an image, a split layout with a product drawing is shown." },
    { "type": "text", "id": "eyebrow", "label": "Small heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Work knee pads that stay up" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Hard shell cap, gel cushion and two adjustable straps with a silicone grip lining. The straps hold onto your pant legs instead of squeezing the back of your knee, so the pads stay put when you stand up.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop knee pads" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_2_label", "label": "Second button label", "default": "See how they work" },
    { "type": "text", "id": "button_2_link", "label": "Second button link", "info": "A URL or an anchor on this page, such as #how", "default": "#how" },
    { "type": "text", "id": "note", "label": "Note under buttons", "info": "Separate items with ·", "default": "Free US shipping · 30-day returns" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
