<section class="section{% if section.settings.alt_background %} section--alt{% endif %}" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor }}"{% endif %}>
  <div class="page-width">
    <div class="section-heading section-heading--center reveal">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="comparison-wrap reveal">
      <table class="comparison">
        <thead>
          <tr>
            <td></td>
            <th scope="col" class="comparison__us">{{ section.settings.us_label }}</th>
            <th scope="col" class="comparison__them">{{ section.settings.them_label }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.feature }}</th>
              <td class="comparison__us"><span>{% render 'icon', name: 'check' %}{{ block.settings.us }}</span></td>
              <td class="comparison__them"><span>{% render 'icon', name: 'dash' %}{{ block.settings.them }}</span></td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison table",
  "class": "section-comparison",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Holdfast vs. typical strap knee pads" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "us_label", "label": "First column", "default": "Holdfast" },
    { "type": "text", "id": "them_label", "label": "Second column", "default": "Typical single-strap pad" },
    { "type": "checkbox", "id": "alt_background", "label": "Alternate background", "default": false }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Staying up" },
        { "type": "text", "id": "us", "label": "First column", "default": "Silicone grip lining" },
        { "type": "text", "id": "them", "label": "Second column", "default": "Strap tension only" }
      ]
    }
  ],
  "presets": [{ "name": "Comparison table", "blocks": [{ "type": "row" }] }]
}
{% endschema %}
