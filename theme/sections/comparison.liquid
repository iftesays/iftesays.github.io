<section class="section" id="{{ section.settings.anchor | default: section.id }}">
  <div class="wrap">
    <div class="section-head section-head--center reveal">
      <p class="label-mono label-mono--accent">{{ section.settings.kicker }}</p>
      <h2 class="h1">{{ section.settings.heading }}</h2>
    </div>
    <div class="compare reveal" role="table" aria-label="{{ section.settings.heading | escape }}">
      <div class="compare__row compare__row--head" role="row">
        <span role="columnheader"></span>
        <span role="columnheader" class="compare__us">{{ section.settings.us_label }}</span>
        <span role="columnheader">{{ section.settings.them_label }}</span>
      </div>
      {%- for block in section.blocks -%}
        <div class="compare__row" role="row" {{ block.shopify_attributes }}>
          <span role="rowheader" class="compare__feat">{{ block.settings.feature }}</span>
          <span role="cell" class="compare__us">{% render 'icon', name: 'check' %}{{ block.settings.us }}</span>
          <span role="cell" class="compare__them">{% render 'icon', name: 'x' %}{{ block.settings.them }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison",
  "class": "section-compare",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Side by side" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not another strap-and-hope pad" },
    { "type": "text", "id": "us_label", "label": "Our column", "default": "Holdfast" },
    { "type": "text", "id": "them_label", "label": "Their column", "default": "Typical strap pads" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Stays up when you stand" },
        { "type": "text", "id": "us", "label": "Holdfast", "default": "Anti-slip lining holds it" },
        { "type": "text", "id": "them", "label": "Typical", "default": "Slides toward the ankle" }
      ]
    }
  ],
  "presets": [{ "name": "Comparison", "blocks": [{ "type": "row" }] }]
}
{% endschema %}
