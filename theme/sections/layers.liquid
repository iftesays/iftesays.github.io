<section class="section layers-sec" id="{{ section.settings.anchor | default: section.id }}">
  <div class="wrap layers-sec__grid">
    <div class="stack reveal" data-stack aria-hidden="true">
      {%- for block in section.blocks -%}
        <div class="stack__layer stack__layer--{{ forloop.index }}" style="--i: {{ forloop.index0 }}" data-layer="{{ forloop.index }}">
          <span>{{ block.settings.title }}</span>
        </div>
      {%- endfor -%}
      <div class="stack__knee">your knee</div>
    </div>
    <div>
      <div class="section-head reveal">
        <p class="label-mono label-mono--accent">{{ section.settings.kicker }}</p>
        <h2 class="h1">{{ section.settings.heading }}</h2>
      </div>
      <ol class="layer-list">
        {%- for block in section.blocks -%}
          <li class="reveal" data-layer-trigger="{{ forloop.index }}" {{ block.shopify_attributes }}>
            <span class="layer-list__n">{{ forloop.index }}</span>
            <div>
              <h3 class="h3">{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Layers (how it works)",
  "class": "section-layers",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "how" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four layers. Each with one job." }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "layer",
      "name": "Layer",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Hard shell cap" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Takes the abuse from concrete, gravel and screws so the cushion underneath doesn't." }
      ]
    }
  ],
  "presets": [{ "name": "Layers", "blocks": [{ "type": "layer" }, { "type": "layer" }, { "type": "layer" }, { "type": "layer" }] }]
}
{% endschema %}
