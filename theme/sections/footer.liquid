{%- assign menu_count = 0 -%}
{%- for block in section.blocks -%}{%- if block.type == 'menu' -%}{%- assign menu_count = menu_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
<footer class="footer">
  <div class="page-width footer__top" style="--menu-cols: {{ menu_count | at_least: 1 }}">
    <div class="footer__about">
      <a href="{{ routes.root_url }}" class="logo">
        <svg class="logo__mark" viewBox="0 0 28 28" aria-hidden="true" focusable="false"><rect width="28" height="28" rx="3" fill="currentColor"/><path d="M8 6.5v15M20 6.5v15M8 14h12" stroke="var(--color-dark)" stroke-width="3.2" stroke-linecap="square"/></svg>
        <span>{{ section.settings.wordmark | default: shop.name }}</span>
      </a>
      {%- if settings.brand_tagline != blank -%}<p>{{ settings.brand_tagline }}</p>{%- endif -%}
      {%- if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_facebook != blank or settings.social_youtube != blank -%}
        <ul class="footer__social">
          {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a></li>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a></li>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a></li>{%- endif -%}
          {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a></li>{%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'menu' -%}
          <div {{ block.shopify_attributes }}>
            <h2 class="footer__heading">{{ block.settings.heading }}</h2>
            <ul class="footer__menu">
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- when 'newsletter' -%}
          <div class="footer__newsletter" {{ block.shopify_attributes }}>
            <h2 class="footer__heading">{{ block.settings.heading }}</h2>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
            {%- form 'customer', id: 'FooterNewsletter' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="form-message form-message--success" role="status">Thanks for signing up.</p>
              {%- else -%}
                <div class="inline-form">
                  <label class="visually-hidden" for="FooterEmail">Email address</label>
                  <input class="input" id="FooterEmail" type="email" name="contact[email]" placeholder="Email address" autocomplete="email" required>
                  <button type="submit" class="btn btn--light btn--small">Sign up</button>
                </div>
                {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
              {%- endif -%}
            {%- endform -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="page-width footer__bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.wordmark | default: shop.name }}</span>
    <ul class="footer__policies">
      {%- for policy in shop.policies -%}
        {%- if policy != blank -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endif -%}
      {%- endfor -%}
    </ul>
    {%- if shop.enabled_payment_types.size > 0 -%}
      <ul class="footer__payment" aria-label="Payment methods">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "wordmark", "label": "Text logo", "default": "Holdfast" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Email sign-up",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Email sign-up" },
        { "type": "text", "id": "text", "label": "Text", "default": "Get restock alerts and new product news." }
      ]
    }
  ]
}
{% endschema %}
