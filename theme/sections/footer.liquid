<footer class="footer">
  <div class="hazard" aria-hidden="true"></div>
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <a href="{{ routes.root_url }}" class="logo logo--light">
        <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="var(--paper)"/><path d="M9 7v18M23 7v18M9 16h14" stroke="var(--accent)" stroke-width="4" stroke-linecap="round"/></svg>
        <span class="logo__word">{{ section.settings.wordmark | default: shop.name }}</span>
      </a>
      <p>{{ settings.brand_tagline }}</p>
      <ul class="socials">
        {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a></li>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a></li>{%- endif -%}
        {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" aria-label="Facebook">{% render 'icon', name: 'facebook' %}</a></li>{%- endif -%}
        {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a></li>{%- endif -%}
      </ul>
    </div>

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'menu' -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <h3 class="label-mono">{{ block.settings.heading }}</h3>
            <ul>
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- when 'newsletter' -%}
          <div class="footer__col footer__col--wide" {{ block.shopify_attributes }}>
            <h3 class="label-mono">{{ block.settings.heading }}</h3>
            <p>{{ block.settings.text }}</p>
            {%- form 'customer', id: 'FooterNewsletter', class: 'inline-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if form.posted_successfully? -%}
                <p class="form-success">You're on the list.</p>
              {%- else -%}
                <label class="visually-hidden" for="FooterEmail">Email</label>
                <input id="FooterEmail" type="email" name="contact[email]" placeholder="you@email.com" required autocomplete="email">
                <button type="submit" class="btn btn--accent btn--small">Join</button>
              {%- endif -%}
              {%- if form.errors -%}<p class="form-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
            {%- endform -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="wrap footer__bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}</span>
    <span class="footer__policies">
      {%- for policy in shop.policies -%}
        {%- if policy != blank -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endif -%}
      {%- endfor -%}
    </span>
    <span class="footer__pay">
      {%- for type in shop.enabled_payment_types -%}
        {{ type | payment_type_svg_tag: class: 'pay-icon' }}
      {%- endfor -%}
    </span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "wordmark", "label": "Text logo", "default": "HOLDFAST" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Job-site intel" },
        { "type": "text", "id": "text", "label": "Text", "default": "Restocks, new gear, and no spam. Unsubscribe anytime." }
      ]
    }
  ]
}
{% endschema %}
