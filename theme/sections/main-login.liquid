<section class="section">
  <div class="page-width" style="max-width: 560px; display: grid; gap: 24px">
    <div class="form-card" id="login">
      <p class="text-muted">Account</p>
      <h1 class="h2">Sign in</h1>
      {%- form 'customer_login' -%}
        {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label class="field"><span>Email</span><input type="email" name="customer[email]" autocomplete="email" required></label>
        <label class="field"><span>Password</span><input type="password" name="customer[password]" autocomplete="current-password" required></label>
        <button type="submit" class="btn btn--full">Sign in</button>
        <p class="form-links"><a href="#recover">Forgot your password?</a> · <a href="{{ routes.account_register_url }}">Create account</a></p>
      {%- endform -%}
    </div>
    <div class="form-card" id="recover">
      <h2 class="h3">Reset your password</h2>
      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}<p class="form-message form-message--success">We've sent you an email with a link to update your password.</p>{%- endif -%}
        {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label class="field"><span>Email</span><input type="email" name="email" autocomplete="email" required></label>
        <button type="submit" class="btn btn--secondary">Send reset link</button>
      {%- endform -%}
    </div>
    {%- if shop.checkout.guest_login -%}
      <div class="form-card">
        <h2 class="h3">Continue as a guest</h2>
        {%- form 'guest_login' -%}<button type="submit" class="btn btn--secondary">Continue</button>{%- endform -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Login", "settings": [] }
{% endschema %}
