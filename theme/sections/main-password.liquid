<section class="password">
  <div class="wrap wrap--narrow center">
    <a class="logo logo--big" href="{{ routes.root_url }}">
      <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="var(--paper)"/><path d="M9 7v18M23 7v18M9 16h14" stroke="var(--accent)" stroke-width="4" stroke-linecap="round"/></svg>
      <span class="logo__word">{{ shop.name }}</span>
    </a>
    <h1 class="password__title">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="password__msg">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'inline-form inline-form--big' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-success">You're on the list. We'll email you when we open.</p>
      {%- else -%}
        <label class="visually-hidden" for="PwEmail">Email</label>
        <input id="PwEmail" type="email" name="contact[email]" placeholder="you@email.com" required>
        <button type="submit" class="btn btn--accent">Notify me</button>
      {%- endif -%}
    {%- endform -%}
    <details class="password__login">
      <summary class="label-mono">Store owner? Enter password</summary>
      {%- form 'storefront_password', class: 'inline-form' -%}
        {%- if form.errors -%}<p class="form-error">Wrong password.</p>{%- endif -%}
        <input type="password" name="password" placeholder="Password" aria-label="Password">
        <button type="submit" class="btn btn--ghost">Enter</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "class": "section-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Knee pads that stay up. Opening soon." }
  ]
}
{% endschema %}
