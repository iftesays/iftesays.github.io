<div class="password">
  <header class="password__header">
    <span class="logo">
      <svg class="logo__mark" viewBox="0 0 28 28" aria-hidden="true" focusable="false"><rect width="28" height="28" rx="3" fill="currentColor"/><path d="M8 6.5v15M20 6.5v15M8 14h12" stroke="var(--color-bg-alt)" stroke-width="3.2" stroke-linecap="square"/></svg>
      <span>{{ shop.name }}</span>
    </span>
    <details class="password__login">
      <summary>Enter store password</summary>
      {%- form 'storefront_password', class: 'inline-form' -%}
        <label class="visually-hidden" for="StorePassword">Password</label>
        <input class="input" id="StorePassword" type="password" name="password" placeholder="Password" autocomplete="current-password">
        <button type="submit" class="btn btn--secondary btn--small">Enter</button>
        {%- if form.errors -%}<p class="form-message form-message--error" role="alert">Incorrect password.</p>{%- endif -%}
      {%- endform -%}
    </details>
  </header>
  <main class="password__main">
    <div>
      <h1>{{ section.settings.heading }}</h1>
      {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- else -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="prospect,password page">
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status">Thanks. We'll email you when we open.</p>
        {%- else -%}
          <div class="inline-form">
            <label class="visually-hidden" for="PasswordEmail">Email address</label>
            <input class="input" id="PasswordEmail" type="email" name="contact[email]" placeholder="Email address" autocomplete="email" required>
            <button type="submit" class="btn">Notify me</button>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </main>
  <footer class="password__footer"><span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span><span>Powered by Shopify</span></footer>
</div>

{% schema %}
{
  "name": "Password page",
  "class": "section-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    { "type": "text", "id": "text", "label": "Text", "default": "Holdfast work knee pads. Enter your email and we'll let you know when the store opens." }
  ]
}
{% endschema %}
