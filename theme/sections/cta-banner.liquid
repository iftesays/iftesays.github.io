<section class="cta-banner">
  <div class="hazard" aria-hidden="true"></div>
  <div class="wrap cta-banner__inner reveal">
    <h2 class="cta-banner__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_link != blank -%}
      <a href="{{ section.settings.button_link }}" class="btn btn--ink btn--big">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "CTA banner",
  "class": "section-cta",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stop pulling your knee pads up." },
    { "type": "text", "id": "text", "label": "Text", "default": "Pads that stay put and don't cut off circulation." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Holdfast" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "CTA banner" }]
}
{% endschema %}
