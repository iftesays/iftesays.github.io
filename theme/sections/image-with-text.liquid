<section class="section{% if section.settings.background == 'alt' %} section--alt{% elsif section.settings.background == 'dark' %} section--dark{% endif %}" {% if section.settings.anchor != blank %}id="{{ section.settings.anchor }}"{% endif %}>
  <div class="page-width image-text{% if section.settings.layout == 'image_right' %} image-text--reverse{% endif %}">
    <div class="image-text__media reveal">
      {%- if section.settings.image != blank -%}
        {%- assign alt = section.settings.image.alt | default: '' -%}
        <div class="media media--{{ section.settings.ratio }} media--zoom">
          {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 750px) 50vw, 100vw', alt: alt }}
        </div>
      {%- else -%}
        <div class="media media--{{ section.settings.ratio }} media--drawing">{% render 'drawing', name: section.settings.drawing, uid: section.id %}</div>
      {%- endif -%}
    </div>
    <div class="image-text__content reveal" style="--delay: 80ms">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="image-text__list">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %}<span>{{ block.settings.text }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="{% if section.settings.button_style == 'link' %}link{% else %}btn btn--secondary{% endif %}">{{ section.settings.button_label }}{% if section.settings.button_style == 'link' %}{% render 'icon', name: 'arrow' %}{% endif %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "class": "section-image-text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "drawing", "label": "Drawing shown when there's no image", "default": "side", "options": [
      { "value": "front", "label": "Knee pad, front" },
      { "value": "side", "label": "Knee pad on leg, side" },
      { "value": "section", "label": "Cross-section" },
      { "value": "strap", "label": "Strap grip lining" },
      { "value": "pair", "label": "Pair" }
    ] },
    { "type": "select", "id": "ratio", "label": "Image shape", "default": "square", "options": [
      { "value": "square", "label": "Square" },
      { "value": "portrait", "label": "Portrait" },
      { "value": "landscape", "label": "Landscape" }
    ] },
    { "type": "select", "id": "layout", "label": "Layout", "default": "image_left", "options": [
      { "value": "image_left", "label": "Image left" },
      { "value": "image_right", "label": "Image right" }
    ] },
    { "type": "select", "id": "background", "label": "Background", "default": "none", "options": [
      { "value": "none", "label": "Default" },
      { "value": "alt", "label": "Alternate" },
      { "value": "dark", "label": "Dark" }
    ] },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "info": "Lets links jump here, e.g. #how" },
    { "type": "text", "id": "eyebrow", "label": "Small heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for long days on hard floors" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Made for long days on tile, subfloor and concrete.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "default": "link", "options": [
      { "value": "link", "label": "Text link" },
      { "value": "button", "label": "Button" }
    ] }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "List item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Silicone lining grips your pant leg" }
      ]
    }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
