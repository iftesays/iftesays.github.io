<section class="section{% if section.settings.dark %} section--ink{% endif %}">
  <div class="wrap iwt{% if section.settings.flip %} iwt--flip{% endif %}">
    <div class="iwt__media reveal">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 50vw, 90vw' }}
      {%- else -%}
        <div class="iwt__placeholder">{% render 'product-art', key: 'iwt' %}</div>
      {%- endif -%}
    </div>
    <div class="iwt__copy reveal">
      {%- if section.settings.kicker != blank -%}<p class="label-mono label-mono--accent">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="h1">{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="btn btn--accent">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "class": "section-iwt",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Image with text" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Pair text with an image to tell your story.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "flip", "label": "Image on right", "default": false },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
