{%- capture leg -%}
  <path d="M100 18 V318" stroke="#3a4656" stroke-width="58" stroke-linecap="round"/>
  <path d="M100 18 V318" stroke="#465468" stroke-width="58" stroke-linecap="round" stroke-dasharray="2 14" opacity=".35"/>
  <path d="M60 330 h70 a26 26 0 0 1 26 26 v4 H60 z" fill="#1a1c1f"/>
  <path d="M60 352 h96" stroke="var(--accent)" stroke-width="4"/>
  <circle cx="100" cy="170" r="5" fill="#fff" opacity=".5"/>
  <text x="140" y="174" font-family="JetBrains Mono, monospace" font-size="11" fill="currentColor" opacity=".55">knee</text>
{%- endcapture -%}
{%- capture pad -%}
  <rect x="66" y="-36" width="68" height="72" rx="18" fill="#17191c" stroke="var(--accent)" stroke-width="3"/>
  <rect x="58" y="-30" width="84" height="12" rx="6" fill="#0b0c0e"/>
  <rect x="58" y="18" width="84" height="12" rx="6" fill="#0b0c0e"/>
  <path d="M80 -8 h40 M80 6 h40" stroke="#4b5159" stroke-width="4" stroke-linecap="round"/>
{%- endcapture -%}
<section class="section slip" id="{{ section.settings.anchor | default: section.id }}" data-slip-test>
  <div class="wrap">
    <div class="section-head section-head--center reveal">
      <p class="label-mono label-mono--accent">{{ section.settings.kicker }}</p>
      <h2 class="h1">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="section-head__text rte">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <div class="slip__grid reveal">
      <div class="slip__panel slip__panel--bad">
        <div class="slip__top">
          <span class="label-mono">Typical strap pads</span>
          <span class="slip__phase"><span class="slip__kneel">Kneel</span><span class="slip__stand">Stand</span></span>
        </div>
        <svg class="slip__svg" viewBox="0 0 200 370" aria-hidden="true">
          {{ leg }}
          <g class="slip__pad slip__pad--slide" transform="translate(0 170)"><g>{{ pad }}</g></g>
        </svg>
        <div class="slip__stat">
          <span>Times pulled back up</span>
          <strong data-slip-count>0</strong>
        </div>
        <ul class="slip__list">
          <li>{% render 'icon', name: 'x' %} Slides toward the ankle every time you stand</li>
          <li>{% render 'icon', name: 'x' %} Crank it tighter and your leg goes numb</li>
        </ul>
      </div>

      <div class="slip__vs" aria-hidden="true">VS</div>

      <div class="slip__panel slip__panel--good">
        <div class="slip__top">
          <span class="label-mono">Holdfast</span>
          <span class="slip__phase"><span class="slip__kneel">Kneel</span><span class="slip__stand">Stand</span></span>
        </div>
        <svg class="slip__svg" viewBox="0 0 200 370" aria-hidden="true">
          {{ leg }}
          <g class="slip__pad slip__pad--hold" transform="translate(0 170)"><g>{{ pad }}</g></g>
        </svg>
        <div class="slip__stat">
          <span>Times pulled back up</span>
          <strong>0</strong>
        </div>
        <ul class="slip__list">
          <li>{% render 'icon', name: 'check' %} Grip lining holds onto your pants</li>
          <li>{% render 'icon', name: 'check' %} Split straps hold without squeezing</li>
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Slip test",
  "class": "section-slip",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "slip-test" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The stand-up test" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Kneel. Stand. Repeat 200 times a day." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>That's where most knee pads give up. Watch what happens every time you get off your knees.</p>" }
  ],
  "presets": [{ "name": "Slip test" }]
}
{% endschema %}
