<section class="section{% if section.settings.alt_background %} section--alt{% endif %}">
  <div class="page-width">
    <div class="carousel" data-carousel>
      <div class="section-heading section-heading--row reveal">
        <div>
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        </div>
        <div class="carousel__nav">
          <button type="button" class="carousel__button carousel__button--prev" data-carousel-prev aria-label="Scroll left">{% render 'icon', name: 'arrow' %}</button>
          <button type="button" class="carousel__button" data-carousel-next aria-label="Scroll right">{% render 'icon', name: 'arrow' %}</button>
        </div>
      </div>
      <ul class="carousel__track" data-carousel-track role="list" style="list-style: none; margin: 0; padding-left: 0">
        {%- for block in section.blocks -%}
          <li class="carousel__slide reveal" style="--delay: {{ forloop.index0 | times: 60 | at_most: 240 }}ms" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="trade-card">{%- else -%}<div class="trade-card">{%- endif -%}
              {%- if block.settings.image != blank -%}
                {%- assign alt = block.settings.image.alt | default: '' -%}
                <div class="media media--zoom">{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 40vw, 72vw', alt: alt }}</div>
              {%- else -%}
                <div class="media"><div class="trade-card__placeholder">{% render 'icon', name: block.settings.icon %}</div></div>
              {%- endif -%}
              <h3 class="trade-card__title">{{ block.settings.title }}</h3>
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
            {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trades carousel",
  "class": "section-trades",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for your trade" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "alt_background", "label": "Alternate background", "default": true }
  ],
  "blocks": [
    {
      "type": "trade",
      "name": "Trade",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait photo (4:5) of the pads on the job." },
        { "type": "select", "id": "icon", "label": "Icon shown without an image", "default": "flooring", "options": [
          { "value": "flooring", "label": "Flooring" },
          { "value": "tile", "label": "Tile" },
          { "value": "hvac", "label": "HVAC" },
          { "value": "electrical", "label": "Electrical" },
          { "value": "plumbing", "label": "Plumbing" },
          { "value": "framing", "label": "Framing" },
          { "value": "roofing", "label": "Roofing" },
          { "value": "concrete", "label": "Concrete" },
          { "value": "mechanic", "label": "Mechanic" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Flooring" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Trades carousel", "blocks": [{ "type": "trade" }, { "type": "trade" }, { "type": "trade" }, { "type": "trade" }] }]
}
{% endschema %}
