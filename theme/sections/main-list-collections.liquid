<div class="page-width">
  <header class="page-header"><h1>Collections</h1></header>
  <div class="grid">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="card reveal">
        {%- if collection.featured_image -%}
          {%- assign alt = collection.featured_image.alt | default: collection.title -%}
          <div class="media media--zoom">{{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: alt }}</div>
        {%- else -%}
          <div class="media media--drawing">{% render 'drawing', name: 'front', uid: collection.id %}</div>
        {%- endif -%}
        <h2 class="card__title">{{ collection.title }}</h2>
        <p class="card__price">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</p>
      </a>
    {%- endfor -%}
  </div>
</div>
<div style="height: var(--section-space)"></div>

{% schema %}
{ "name": "Collections list", "class": "section-list-collections", "settings": [] }
{% endschema %}
