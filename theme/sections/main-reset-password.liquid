<section class="section">
  <div class="page-width" style="max-width: 560px; display: grid; gap: 24px">
    <div class="form-card">
      <h1 class="h2">Reset password</h1>
      {%- form 'reset_customer_password' -%}
        {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label class="field"><span>New password</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
        <label class="field"><span>Confirm password</span><input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
        <button type="submit" class="btn btn--full">Reset password</button>
      {%- endform -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
