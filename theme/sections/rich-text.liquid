<section class="section{% if section.settings.background == 'alt' %} section--alt{% elsif section.settings.background == 'dark' %} section--dark{% endif %}">
  <div class="page-width">
    <div class="rich-text{% if section.settings.center %} rich-text--center{% endif %} reveal">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="btn{% if section.settings.background == 'dark' %} btn--light{% endif %}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "class": "section-rich-text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Holdfast work knee pads" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>$64.99 a pair, or 2 pairs for $109.99. Free US shipping and 30-day returns.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "center", "label": "Center", "default": true },
    { "type": "select", "id": "background", "label": "Background", "default": "none", "options": [
      { "value": "none", "label": "Default" },
      { "value": "alt", "label": "Alternate" },
      { "value": "dark", "label": "Dark" }
    ] }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
