<section class="section{% if section.settings.dark %} section--ink{% endif %}">
  <div class="wrap wrap--narrow{% if section.settings.center %} center{% endif %} reveal">
    {%- if section.settings.kicker != blank -%}<p class="label-mono label-mono--accent">{{ section.settings.kicker }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h1">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="rte rte--lg">{{ section.settings.text }}</div>
    {%- if section.settings.button_link != blank -%}
      <a href="{{ section.settings.button_link }}" class="btn btn--accent">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "class": "section-rich-text",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk about your brand" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share the story behind your products.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "center", "label": "Center", "default": true },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
