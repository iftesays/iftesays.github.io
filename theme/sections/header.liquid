{%- assign menu = linklists[section.settings.menu] -%}
<header class="header">
  <div class="page-width header__inner">
    <div class="header__left">
      <button type="button" class="header__icon header__menu-toggle" data-drawer-open="menu" aria-controls="MenuDrawer" aria-expanded="false" aria-label="Open menu">
        {% render 'icon', name: 'menu' %}
      </button>
      <a href="{{ routes.root_url }}" class="logo" aria-label="{{ shop.name }}, home">
        {%- if section.settings.logo != blank -%}
          {%- assign logo_alt = section.settings.logo.alt | default: shop.name -%}
          {%- assign logo_style = 'width: ' | append: section.settings.logo_width | append: 'px' -%}
          {{ section.settings.logo | image_url: width: 600 | image_tag: class: 'logo__img', style: logo_style, alt: logo_alt, widths: '200, 400, 600' }}
        {%- else -%}
          <svg class="logo__mark" viewBox="0 0 28 28" aria-hidden="true" focusable="false"><rect width="28" height="28" rx="3" fill="currentColor"/><path d="M8 6.5v15M20 6.5v15M8 14h12" stroke="var(--color-bg)" stroke-width="3.2" stroke-linecap="square"/></svg>
          <span>{{ section.settings.wordmark | default: shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <nav class="header__nav" aria-label="Main">
      <ul>
        {%- for link in menu.links -%}
          <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__right">
      <a href="{{ routes.search_url }}" class="header__icon hide-mobile" aria-label="Search">{% render 'icon', name: 'search' %}</a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__icon hide-mobile" aria-label="Account">{% render 'icon', name: 'account' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="header__icon" data-drawer-open="cart" aria-controls="CartDrawer" aria-expanded="false" aria-label="Cart, {{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}">
        {% render 'icon', name: 'cart' %}
        <span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

<div class="drawer drawer--left" id="MenuDrawer" data-drawer="menu" aria-hidden="true">
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="drawer__header">
      <span class="drawer__title">Menu</span>
      <button type="button" class="header__icon" data-drawer-close aria-label="Close menu">{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="drawer__body">
      <ul class="menu-drawer__list">
        {%- for link in menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}{% render 'icon', name: 'chevron' %}</a></li>
        {%- endfor -%}
      </ul>
      <ul class="menu-drawer__secondary">
        <li><a href="{{ routes.search_url }}">{% render 'icon', name: 'search' %}Search</a></li>
        {%- if shop.customer_accounts_enabled -%}
          <li><a href="{{ routes.account_url }}">{% render 'icon', name: 'account' %}{% if customer %}Account{% else %}Sign in{% endif %}</a></li>
        {%- endif -%}
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 260, "step": 10, "unit": "px", "default": 140 },
    { "type": "text", "id": "wordmark", "label": "Text logo", "info": "Shown when no logo image is set.", "default": "Holdfast" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
