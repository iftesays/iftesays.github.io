<div class="page-width not-found">
  <h1>Page not found</h1>
  <p>The page you're looking for has moved or doesn't exist.</p>
  <div class="hero__buttons" style="justify-content: center">
    <a href="{{ settings.primary_product.url | default: routes.all_products_collection_url }}" class="btn">Shop knee pads</a>
    <a href="{{ routes.root_url }}" class="btn btn--secondary">Go to homepage</a>
  </div>
</div>

{% schema %}
{ "name": "404", "class": "section-404", "settings": [] }
{% endschema %}
