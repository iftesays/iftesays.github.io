<div class="ticker ticker--{{ section.settings.style }}{% if section.settings.tilt %} ticker--tilt{% endif %}">
  <div class="ticker__track" style="--ticker-speed: {{ section.settings.speed }}s">
    {%- for i in (1..2) -%}
      <div class="ticker__group" {% if i == 2 %}aria-hidden="true"{% endif %}>
        {%- assign items = section.settings.items | split: ',' -%}
        {%- for item in items -%}
          <span>{{ item | strip }}</span><span class="ticker__sep" aria-hidden="true">{% render 'icon', name: 'plus' %}</span>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Ticker",
  "class": "section-ticker",
  "settings": [
    { "type": "textarea", "id": "items", "label": "Items (comma separated)", "default": "Flooring, Tile, Carpet, HVAC, Electrical, Plumbing, Framing, Roofing, Concrete, Landscaping, Mechanics, Serious DIY" },
    { "type": "select", "id": "style", "label": "Style", "default": "accent", "options": [
      { "value": "accent", "label": "Orange" },
      { "value": "ink", "label": "Dark" },
      { "value": "signal", "label": "Hi-vis" }
    ] },
    { "type": "checkbox", "id": "tilt", "label": "Tilted", "default": true },
    { "type": "range", "id": "speed", "label": "Loop duration", "min": 10, "max": 80, "step": 5, "unit": "s", "default": 35 }
  ],
  "presets": [{ "name": "Ticker" }]
}
{% endschema %}
