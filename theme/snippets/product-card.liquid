{%- comment -%} Usage: {% render 'product-card', product: product %} {%- endcomment -%}
<a href="{{ product.url }}" class="card reveal">
  {%- if product.featured_media -%}
    {%- assign alt = product.featured_media.alt | default: product.title -%}
    <div class="media media--product media--zoom">
      {{ product.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw', alt: alt }}
      {%- if product.media.size > 1 -%}
        <div class="card__media-secondary">{{ product.media[1] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw', alt: '' }}</div>
      {%- endif -%}
      {%- if product.compare_at_price_max > product.price_min -%}<span class="badge card__badge">Save on 2 pairs</span>{%- endif -%}
    </div>
  {%- else -%}
    <div class="media media--drawing">
      {% render 'drawing', name: 'front', uid: product.id %}
      {%- if product.compare_at_price_max > product.price_min -%}<span class="badge card__badge">Save on 2 pairs</span>{%- endif -%}
    </div>
  {%- endif -%}
  <h3 class="card__title">{{ product.title }}</h3>
  <p class="card__price">{% if product.price_varies %}From {% endif %}{{ product.price_min | money }}</p>
</a>
