{%- comment -%} Line icons, 24px grid. Usage: {% render 'icon', name: 'cart' %} {%- endcomment -%}
{%- capture a -%}class="icon icon-{{ name }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"{%- endcapture -%}
{%- case name -%}
  {%- when 'cart' -%}<svg {{ a }}><path d="M5 7h14l-1.2 11.1a2 2 0 0 1-2 1.9H8.2a2 2 0 0 1-2-1.9z"/><path d="M9 10V6.5a3 3 0 0 1 6 0V10"/></svg>
  {%- when 'menu' -%}<svg {{ a }}><path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17"/></svg>
  {%- when 'close' -%}<svg {{ a }}><path d="M6 6l12 12M18 6 6 18"/></svg>
  {%- when 'search' -%}<svg {{ a }}><circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.6-4.6"/></svg>
  {%- when 'account' -%}<svg {{ a }}><circle cx="12" cy="8" r="4"/><path d="M4.5 20.5c1.3-3.8 4.2-5.8 7.5-5.8s6.2 2 7.5 5.8"/></svg>
  {%- when 'arrow' -%}<svg {{ a }}><path d="M4.5 12h15M13.5 6l6 6-6 6"/></svg>
  {%- when 'chevron' -%}<svg {{ a }}><path d="m9 5 7 7-7 7"/></svg>
  {%- when 'plus' -%}<svg {{ a }}><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'minus' -%}<svg {{ a }}><path d="M5 12h14"/></svg>
  {%- when 'check' -%}<svg {{ a }}><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
  {%- when 'dash' -%}<svg {{ a }}><path d="M7 12h10"/></svg>
  {%- when 'x' -%}<svg {{ a }}><path d="m7 7 10 10M17 7 7 17"/></svg>
  {%- when 'truck' -%}<svg {{ a }}><path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3.2v2.8h-7"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
  {%- when 'shield' -%}<svg {{ a }}><path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.2 7.5 9.5 4.3-1.3 7.5-4.9 7.5-9.5V6z"/><path d="m8.8 12.2 2.3 2.3 4.2-4.6"/></svg>
  {%- when 'return' -%}<svg {{ a }}><path d="M4 9h11a5 5 0 0 1 0 10H8"/><path d="M8 5 4 9l4 4"/></svg>
  {%- when 'lock' -%}<svg {{ a }}><rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></svg>
  {%- when 'box' -%}<svg {{ a }}><path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/></svg>
  {%- when 'clock' -%}<svg {{ a }}><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
  {%- when 'mail' -%}<svg {{ a }}><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/></svg>
  {%- when 'chat' -%}<svg {{ a }}><path d="M20.5 12a8 8 0 0 1-11.8 7L3.5 20.5 5 15.6A8 8 0 1 1 20.5 12z"/></svg>
  {%- when 'star' -%}<svg class="icon icon-star" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="m12 3 2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 16.8l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8z"/></svg>
  {%- when 'star-outline' -%}<svg {{ a }}><path d="m12 3 2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 16.8l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8z"/></svg>
  {%- when 'grip' -%}<svg {{ a }}><rect x="3" y="7" width="18" height="10" rx="5"/><path d="M7.5 10.5h2M11 10.5h2M14.5 10.5h2M7.5 13.5h2M11 13.5h2M14.5 13.5h2"/></svg>
  {%- when 'straps' -%}<svg {{ a }}><rect x="3" y="5" width="18" height="3.5" rx="1.75"/><rect x="3" y="15.5" width="18" height="3.5" rx="1.75"/><path d="M8 8.5v7M16 8.5v7"/></svg>
