  {%- when 'ruler' -%}<svg {{ a }}><rect x="2.5" y="7.5" width="19" height="9" rx="1.5"/><path d="M6.5 7.5v3M10 7.5v4.5M13.5 7.5v3M17 7.5v4.5"/></svg>
  {%- when 'knee' -%}<svg {{ a }}><path d="M9 2.5c.5 4 1.5 7 3.5 9 1.5 1.5 1.6 3.4.5 5.2L11 21.5"/><path d="M15 2.5c0 4-.4 6.4.8 8.6"/><circle cx="15.5" cy="13" r="2.2"/></svg>
  {%- when 'flooring' -%}<svg {{ a }}><path d="M3 7h18M3 12h18M3 17h18M3 3.5h18v17H3z"/><path d="M9 3.5V7M15 7v5M7 12v5M17 17v3.5M12 17v3.5"/></svg>
  {%- when 'tile' -%}<svg {{ a }}><rect x="3.5" y="3.5" width="7.5" height="7.5" rx=".5"/><rect x="13" y="3.5" width="7.5" height="7.5" rx=".5"/><rect x="3.5" y="13" width="7.5" height="7.5" rx=".5"/><rect x="13" y="13" width="7.5" height="7.5" rx=".5"/></svg>
  {%- when 'hvac' -%}<svg {{ a }}><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="1.5"/><path d="M12 10.5c-.5-2.5.3-4.5 2.5-5.5M13.5 12c2.5-.5 4.5.3 5.5 2.5M12 13.5c.5 2.5-.3 4.5-2.5 5.5M10.5 12c-2.5.5-4.5-.3-5.5-2.5"/></svg>
  {%- when 'electrical' -%}<svg {{ a }}><path d="M13 2.5 5.5 13.5H12l-1 8 7.5-11H12z"/></svg>
  {%- when 'plumbing' -%}<svg {{ a }}><path d="M3.5 8h7a3 3 0 0 1 3 3v9.5"/><path d="M3.5 4.5h7a6.5 6.5 0 0 1 6.5 6.5v9.5"/><path d="M12 20.5h6.5"/></svg>
  {%- when 'framing' -%}<svg {{ a }}><path d="m14.5 4.5 5 5-2.5 2.5-5-5z"/><path d="M12 7 4 15a2.1 2.1 0 0 0 3 3l8-8"/></svg>
  {%- when 'roofing' -%}<svg {{ a }}><path d="M2.5 12 12 4l9.5 8"/><path d="M5.5 10v9.5h13V10"/><path d="M10 19.5v-5h4v5"/></svg>
  {%- when 'concrete' -%}<svg {{ a }}><path d="M4 15.5 15.5 4l4.5 4.5L8.5 20z"/><path d="m11 9 4 4"/></svg>
  {%- when 'mechanic' -%}<svg {{ a }}><path d="M14.7 6.3a4 4 0 0 0-5.2 5.2L3.5 17.5l3 3 6-6a4 4 0 0 0 5.2-5.2l-2.5 2.5-2.5-.5-.5-2.5z"/></svg>
  {%- when 'instagram' -%}<svg {{ a }}><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor"/></svg>
  {%- when 'tiktok' -%}<svg class="icon icon-tiktok" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M16.6 3c.4 2.4 1.8 3.9 4.2 4.1v3.1c-1.5.1-2.9-.4-4.2-1.2v6.1c0 4.6-4.4 6.9-7.8 5.2-3.7-1.9-3.4-8 1.5-8.6v3.2c-1.9.3-2.4 2.1-1.2 3.1 1.3 1.1 4.1.6 4.1-2.3V3z"/></svg>
  {%- when 'facebook' -%}<svg class="icon icon-facebook" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M14 8.5V6.8c0-.8.5-1 1-1h2.5V2h-3.4C10.6 2 10 4.6 10 6.3v2.2H7.5V12H10v10h4V12h3l.5-3.5z"/></svg>
  {%- when 'youtube' -%}<svg class="icon icon-youtube" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M22 8.2a3 3 0 0 0-2.1-2.1C18 5.6 12 5.6 12 5.6s-6 0-7.9.5A3 3 0 0 0 2 8.2 31 31 0 0 0 1.6 12 31 31 0 0 0 2 15.8a3 3 0 0 0 2.1 2.1c1.9.5 7.9.5 7.9.5s6 0 7.9-.5a3 3 0 0 0 2.1-2.1c.3-1.3.4-2.5.4-3.8s-.1-2.5-.4-3.8zM10 15V9l5.2 3z"/></svg>
