{%- comment -%}
  Illustrated knee pad, used wherever a product has no photos yet.
  Usage: {% render 'product-art', key: 'hero', pair: true, label: 'HOLDFAST' %}
{%- endcomment -%}
{%- assign uid = 'pa-' | append: section.id | append: '-' | append: key | handleize -%}
{%- assign label = label | default: 'HOLDFAST' -%}
<svg class="product-art{% if pair %} product-art--pair{% endif %}" viewBox="0 0 400 400" role="img" aria-label="Holdfast work knee pad illustration">
  <defs>
    <linearGradient id="{{ uid }}-cap" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3b4047"/><stop offset=".55" stop-color="#1d2024"/><stop offset="1" stop-color="#0d0f11"/></linearGradient>
    <linearGradient id="{{ uid }}-foam" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2b2f35"/><stop offset="1" stop-color="#121417"/></linearGradient>
    <linearGradient id="{{ uid }}-shine" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset=".5" stop-color="#fff" stop-opacity=".18"/><stop offset="1" stop-color="#fff" stop-opacity="0"/></linearGradient>
    <radialGradient id="{{ uid }}-shadow" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#000" stop-opacity=".45"/><stop offset="1" stop-color="#000" stop-opacity="0"/></radialGradient>
    <g id="{{ uid }}-pad">
      <rect x="46" y="96" width="308" height="34" rx="17" fill="#0b0c0e"/>
      <rect x="54" y="104" width="292" height="18" rx="9" fill="none" stroke="var(--accent, #ff5f1f)" stroke-width="2" stroke-dasharray="6 6"/>
      <rect x="56" y="268" width="288" height="34" rx="17" fill="#0b0c0e"/>
      <rect x="64" y="276" width="272" height="18" rx="9" fill="none" stroke="var(--accent, #ff5f1f)" stroke-width="2" stroke-dasharray="6 6"/>
      <path d="M120 60 C120 38 280 38 280 60 L296 300 C296 354 104 354 104 300 Z" fill="url(#{{ uid }}-foam)" stroke="#43484f" stroke-width="3"/>
      <path d="M138 120 C138 90 262 90 262 120 L270 270 C270 318 130 318 130 270 Z" fill="url(#{{ uid }}-cap)" stroke="var(--accent, #ff5f1f)" stroke-width="4"/>
      <path d="M158 150 H242 M154 185 H246 M152 220 H248 M156 255 H244" stroke="#4b5159" stroke-width="6" stroke-linecap="round"/>
      <path d="M150 112 C170 100 230 100 250 112 L254 170 C220 160 180 160 146 170 Z" fill="url(#{{ uid }}-shine)"/>
      <rect x="300" y="100" width="40" height="26" rx="6" fill="var(--accent, #ff5f1f)"/>
      <rect x="292" y="272" width="40" height="26" rx="6" fill="var(--accent, #ff5f1f)"/>
      <text x="200" y="208" text-anchor="middle" font-family="Archivo Black, sans-serif" font-size="25" fill="#f1eee6" letter-spacing="2">{{ label | escape }}</text>
    </g>
  </defs>
  <ellipse cx="200" cy="372" rx="150" ry="16" fill="url(#{{ uid }}-shadow)"/>
  {%- if pair -%}
    <use href="#{{ uid }}-pad" transform="translate(-34 6) scale(.78) rotate(-8 200 200)" opacity=".85"/>
    <use href="#{{ uid }}-pad" transform="translate(120 52) scale(.78) rotate(6 200 200)"/>
  {%- else -%}
    <use href="#{{ uid }}-pad"/>
  {%- endif -%}
</svg>
