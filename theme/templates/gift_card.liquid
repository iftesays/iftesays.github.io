{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Your {{ gift_card.initial_value | money }} gift card · {{ shop.name }}</title>
  {% render 'css-variables' %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body class="template-gift-card">
  <main>
    <div class="page-width">
      <div class="giftcard">
        <p class="text-muted">{{ shop.name }} gift card</p>
        <p class="giftcard__value">{{ gift_card.balance | money }}</p>
        {%- if gift_card.balance != gift_card.initial_value -%}<p>Original value {{ gift_card.initial_value | money }}</p>{%- endif -%}
        {%- if gift_card.expired or gift_card.enabled == false -%}<p class="form-message form-message--error">This gift card is {% if gift_card.expired %}expired{% else %}disabled{% endif %}.</p>{%- endif -%}
        <p class="text-muted" style="margin-bottom: 0">Gift card code</p>
        <p class="giftcard__code">{{ gift_card.code | format_code }}</p>
        <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
        <div class="hero__buttons" style="justify-content: center; margin-bottom: 20px">
          <a href="{{ shop.url }}" class="btn">Start shopping</a>
          <button type="button" class="btn btn--secondary" onclick="window.print()">Print</button>
        </div>
        {%- if gift_card.pass_url -%}<a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Add to Apple Wallet" loading="lazy"></a>{%- endif -%}
      </div>
    </div>
  </main>
  <script>
    window.addEventListener('load', function () {
      var el = document.getElementById('QrCode');
      if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
    });
  </script>
</body>
</html>
