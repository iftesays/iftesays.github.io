{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Your {{ gift_card.initial_value | money }} gift card · {{ shop.name }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <style>:root{--ink:{{ settings.color_ink }};--paper:{{ settings.color_paper }};--accent:{{ settings.color_accent }};--accent-rgb:255,95,31;--signal:{{ settings.color_signal }};}</style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body class="template-gift-card">
  <main class="section">
    <div class="wrap wrap--form center">
      <div class="form-card giftcard">
        <p class="label-mono label-mono--accent">{{ shop.name }} gift card</p>
        <p class="giftcard__value">{{ gift_card.balance | money }}</p>
        {%- if gift_card.balance != gift_card.initial_value -%}<p>Original value {{ gift_card.initial_value | money }}</p>{%- endif -%}
        {%- if gift_card.expired or gift_card.enabled == false -%}<p class="form-error">This gift card is {% if gift_card.expired %}expired{% else %}disabled{% endif %}.</p>{%- endif -%}
        <p class="label-mono">Code</p>
        <p class="giftcard__code">{{ gift_card.code | format_code }}</p>
        <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
        <div class="giftcard__btns">
          <a href="{{ shop.url }}" class="btn btn--accent">Start shopping</a>
          <button type="button" class="btn btn--ghost" onclick="window.print()">Print</button>
        </div>
        {%- if gift_card.pass_url -%}<a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Add to Apple Wallet" loading="lazy"></a>{%- endif -%}
      </div>
    </div>
  </main>
  <script>
    window.addEventListener('load', function () {
      var el = document.getElementById('QrCode');
      if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
    });
  </script>
</body>
</html>
